{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GOLDB": "Host=localhost;Port=5432;Database=goldb;Username=postgres;Password=123456",
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/goldb-.log", "rollingInterval": "Day" } }
    ]
  }
}
